{
  "name": "spc-parser",
  "version": "2.1.1",
  "description": "Parser for Thermo Galactic GRAMS SPC and Shimadzu UVProbe .spc files",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "npm run tsc && cheminfo-build --entry lib/index.js --root SPCParser",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/spc-parser.git"
  },
  "keywords": [],
  "author": "Benjamin Yiu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cheminfo/spc-parser/issues"
  },
  "homepage": "https://github.com/cheminfo/spc-parser#readme",
  "dependencies": {
    "cfb": "^1.2.2",
    "cheminfo-types": "^1.15.0",
    "iobuffer": "^6.0.1",
    "ml-spectra-processing": "^14.33.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@zakodium/tsconfig": "^1.0.5",
    "cheminfo-build": "^1.4.0",
    "eslint": "^9.27.0",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "xy-parser": "^6.0.1"
  }
}
